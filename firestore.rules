rules_version = '2';

// All Firestore access for the Pantaleo CRM goes exclusively through the
// Firebase Admin SDK (server-side API routes on Vercel). The Admin SDK
// bypasses these security rules entirely, so we can deny all client-side
// access without breaking the application.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
